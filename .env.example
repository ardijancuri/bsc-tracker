PORT=3302
HOST=127.0.0.1
DATABASE_URL=postgres://bscan:change-me@127.0.0.1:5436/kollens_fresh
BSC_RPC_HTTP=http://127.0.0.1:8545
BSC_RPC_WS=ws://127.0.0.1:8546
# Optional server-only historical code source for token-birth discovery.
# Unset means node-only discovery; there is no automatic public fallback.
# Never use a VITE_ variable. This source cannot submit transactions or prices.
FRESH_DISCOVERY_ARCHIVE_RPC_URL=
# Optional private worker-only IPC socket. Enabling/mounting it requires separate authorization.
BSC_TRACE_IPC=
# GMGN supplies on-demand charts only. Financial accounting uses the local journal.
# The chart key serves browsing; the second key serves selected replay preparation.
# Never prefix this with VITE_ or put it in browser configuration.
GMGN_CHART_API_KEY=
# Reused second credential for replay candles (legacy variable name).
# Falls back to GMGN_CHART_API_KEY, then GMGN_API_KEY, when absent.
GMGN_ACCOUNTING_API_KEY=
# Optional single-account fallback. Equal credentials share one queue.
GMGN_API_KEY=
# Opt-in credential-free request/cache timing diagnostics in server logs.
GMGN_REQUEST_DIAGNOSTICS=false
GMGN_CHART_CACHE_DIR=.cache/fresh/charts
# At least 32 random bytes/characters; server-only. Prepared objects stay in bounded memory.
FRESH_REPLAY_SECRET=

BSCAN_DB_PASSWORD=change-me
PUBLIC_APP_URL=https://kollens.com
# Optional Telegram login. Leave both empty to keep guest-only watchlists.
# BotFather > dedicated Kollens Login bot > Login Widget > Client ID / Secret.
# These are OIDC credentials, not a bot token. Never use a VITE_ prefix.
# Register ${PUBLIC_APP_URL}/api/auth/telegram/callback in BotFather Allowed URLs.
# Local login needs its own registered development callback; see docs/telegram-login.md.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Optional, separate messaging consent for favorite-KOL live trade alerts.
# Required for bot-first login and optional alerts; SAME bot as TELEGRAM_CLIENT_ID.
TELEGRAM_BOT_TOKEN=
# Random 32+ character secret used when registering /api/telegram/webhook.
# Local testing never registers or modifies the production webhook.
TELEGRAM_WEBHOOK_SECRET=
# Optional persistent hashed browser assets; Compose sets this on its own volume.
# Recent release chunks remain available to tabs opened before a deployment.
FRONTEND_ASSET_CACHE_DIR=

# Fresh v1.4 production preparation uses compose.fresh.vps.yaml as a separate
# project. It never reuses the live bscan database/volume. Keep this disabled
# until the separately approved cutover; do not copy local credentials to VPS.
FRESH_RELEASE_ID=
# Use 32+ random URL-safe characters, e.g. a hex secret, because this is also
# embedded in the database URI. Do not reuse BSCAN_DB_PASSWORD.
FRESH_DB_PASSWORD=
FRESH_APP_PORT=3303
# Source URL is used only by the guarded, source-read-only operator.
FRESH_CUTOVER_SOURCE_DATABASE_URL=
FRESH_CUTOVER_DIR=
# Leave empty during preview/capture. The activation override is separate and
# requires the approved Telegram delivery ownership/start-block handoff.
FRESH_TELEGRAM_BOT_TOKEN=
FRESH_TELEGRAM_ACTIVE=false
