PORT=3300
DATABASE_URL=postgres://bscan:change-me@127.0.0.1:5434/bscan
BSC_RPC_HTTP=http://127.0.0.1:8545
BSC_RPC_WS=ws://127.0.0.1:8546
# Optional private worker-only IPC socket. Enabling/mounting it requires separate authorization.
BSC_TRACE_IPC=
# GMGN credentials belong to historical import workers only, never the web API.
# Normal trades, P&L, current prices and replay charts read PostgreSQL/node evidence.
# Set to 0 to validate with all historical import provider requests disabled.
NODE_HISTORICAL_IMPORTS=1
# Operator-only, one-shot capture migration; exits after recording a gap and
# confirmed boundary. Leave unset for normal workers; see docs/node-evidence.md.
# NODE_CAPTURE_BOOTSTRAP=1
# Historical market candles only.
# Never prefix this with VITE_ or put it in browser configuration.
GMGN_CHART_API_KEY=
# Historical activity, transfers and aggregate baseline evidence only.
# Falls back to GMGN_CHART_API_KEY, then GMGN_API_KEY, when absent.
GMGN_ACCOUNTING_API_KEY=
# Optional single-account fallback for imports.
GMGN_API_KEY=
# Opt-in credential-free request/cache timing diagnostics in server logs.
GMGN_REQUEST_DIAGNOSTICS=false

BSCAN_DB_PASSWORD=change-me
PUBLIC_APP_URL=https://kollens.com
# Optional Telegram login. Leave both empty to keep guest-only watchlists.
# BotFather > dedicated Kollens Login bot > Login Widget > Client ID / Secret.
# These are OIDC credentials, not a bot token. Never use a VITE_ prefix.
# Register ${PUBLIC_APP_URL}/api/auth/telegram/callback in BotFather Allowed URLs.
# Local login needs its own registered development callback; see docs/telegram-login.md.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Optional, separate messaging consent for favorite-KOL live trade alerts.
# Required for bot-first login and optional alerts; SAME bot as TELEGRAM_CLIENT_ID.
TELEGRAM_BOT_TOKEN=
# Random 32+ character secret used when registering /api/telegram/webhook.
# Local testing never registers or modifies the production webhook.
TELEGRAM_WEBHOOK_SECRET=
# Optional persistent hashed browser assets; Compose sets this on its own volume.
# Recent release chunks remain available to tabs opened before a deployment.
FRONTEND_ASSET_CACHE_DIR=
