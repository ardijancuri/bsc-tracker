PORT=3300
DATABASE_URL=postgres://bscan:change-me@127.0.0.1:5434/bscan
BSC_RPC_HTTP=http://127.0.0.1:8545
BSC_RPC_WS=ws://127.0.0.1:8546
# Keyless CoinMarketCap latest OHLCV is the default token chart provider.
# Optional cap (1–1000) limits fetched bars; it also limits available history.
CMC_CHART_MAX_CANDLES=1000
# Server-only GMGN read-only key dedicated to token/replay charts.
# Its allowance is reserved for the app, separate from worker profit checks.
# Never prefix this with VITE_ or put it in browser configuration.
GMGN_CHART_API_KEY=
# Optional legacy shared key; also enables worker profit snapshots.
GMGN_API_KEY=

BSCAN_DB_PASSWORD=change-me
PUBLIC_APP_URL=https://kollens.com
# Optional persistent hashed browser assets; Compose sets this on its own volume.
# Recent release chunks remain available to tabs opened before a deployment.
FRONTEND_ASSET_CACHE_DIR=
# Keep delivery off until collection is verified and the dedicated bot is configured.
