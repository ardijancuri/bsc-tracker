{
  "name": "bscan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "dev:worker": "tsx watch server/worker.ts",
    "build": "vite build && esbuild server/index.ts server/worker.ts server/compressTokenImages.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-server",
    "start": "node dist-server/index.js",
    "worker": "node dist-server/worker.js",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^10.1.5",
    "@fontsource/manrope": "^5.2.0",
    "fastify": "^5.12.5",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "sharp": "^0.35.4",
    "undici": "^7.30.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
