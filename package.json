{
  "name": "bscan",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "brand:export": "node scripts/export-app-brand.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.telegram.local --import tsx --watch server/index.ts",
    "dev:worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.telegram.local --import tsx --watch server/worker.ts",
    "build": "npm run brand:export && vite build && esbuild server/index.ts server/worker.ts server/compressTokenImages.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-server",
    "start": "node dist-server/index.js",
    "worker": "node dist-server/worker.js",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:integration": "tsx server/intelligence.integration.ts",
    "test:integration:auth": "tsx server/accountWatchlist.integration.ts",
    "test:integration:notifications": "tsx server/telegramNotifications.integration.ts",
    "test:integration:kol-profile": "tsx server/kolProfile.integration.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^10.1.5",
    "@fontsource/manrope": "^5.2.0",
    "ethers": "^6.17.0",
    "fastify": "^5.12.5",
    "ipaddr.js": "^2.5.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.468.0",
    "mediabunny": "1.61.3",
    "openid-client": "^6.8.8",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "sharp": "^0.35.4",
    "undici": "^7.30.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
